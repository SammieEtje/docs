{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:links": "markdown-link-check 'docs/**/*.md' --config .markdown-link-check.json",
    "test:markdown": "markdownlint 'docs/**/*.md' --config .markdownlint.json",
    "test:build": "docusaurus build",
    "test:all": "npm test && npm run test:links && npm run test:markdown && npm run test:build"
  },
  "dependencies": {
    "@docusaurus/core": "^2.0.0-alpha.54",
    "@docusaurus/preset-classic": "^2.0.0-alpha.54",
    "@openapitools/openapi-generator-cli": "^1.0.13-4.3.1",
    "classnames": "^2.2.6",
    "plantuml-encoder": "^1.4.0",
    "react": "^16.8.4",
    "react-dom": "^16.8.4",
    "remarkable-plantuml": "^1.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-react": "^7.18.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^12.1.5",
    "babel-jest": "^29.5.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-axe": "^8.0.0",
    "markdown-link-check": "^3.11.0",
    "markdownlint-cli": "^0.37.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
